# Porta HTTP (o Render injeta automaticamente)
PORT=3000

# URL de conexão do PostgreSQL (Neon). Ausente → usa SQLite local (modo LAN).
DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require

# PIN obrigatório em toda ação da API (exceto /api/health). Vazio → desligado (modo LAN).
# Em produção (Render) é obrigatório, com no mínimo 8 caracteres; 5 erros seguidos
# bloqueiam o IP por 15 min. Sem ele (ou sem DATABASE_URL) o servidor se recusa a subir.
RIFA_PIN=

# Credenciais da conta Podium. Se definidas, sobrepõem a config salva no banco
# e a aba de Login é desativada. NUNCA commitar valores reais.
RIFA_CPF=
RIFA_SENHA=
RIFA_TURMA=

# Teto de rifas por pessoa (padrão 100).
MAX_QUANTIDADE=100